<header class="header">
    <div class="header_top">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="Home Shoppe" /></a>
        </div>
        <div class="cart">
            <p>Welcome to our Online Store! <span>Cart:</span></p>
            <span id="cart-summary" aria-live="polite">0 item(s) - $0.00</span>
        </div>
        <div class="clear"></div>
    </div>
    <div class="header_bottom">
        @await Component.InvokeAsync("LoaiHang")
        <div class="search_box">
            <form asp-controller="Home" asp-action="Index" method="get" id="tim-kiem-hang-hoa" role="search">
                <input type="hidden" name="maLoai" id="search-ma-loai" value="@ViewData["MaLoai"]" />
                <input type="text" name="tuKhoa" value="@ViewData["TuKhoa"]" placeholder="Search" aria-label="Tìm hàng hóa" />
                <button type="submit" aria-label="Tìm kiếm"></button>
            </form>
        </div>
        <div class="clear"></div>
    </div>
</header>
