@model IReadOnlyList<LoaiHang>
@{
    var maLoai = ViewData["MaLoai"] as int?;
    var trangChu = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
        && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<nav class="menu" aria-label="Loại hàng">
    <ul>
        <li class="@(trangChu && !maLoai.HasValue ? "active" : null)">
            <a asp-controller="Home" asp-action="Index" data-loai-hang="" aria-current="@(trangChu && !maLoai.HasValue ? "page" : null)">Ngô Minh Chính</a>
        </li>
        @foreach (var loai in Model)
        {
            <li class="@(trangChu && maLoai == loai.MaLoai ? "active" : null)">
                <a asp-controller="Home" asp-action="Index" asp-route-maLoai="@loai.MaLoai" data-loai-hang="@loai.MaLoai" aria-current="@(trangChu && maLoai == loai.MaLoai ? "page" : null)">@loai.TenLoai</a>
            </li>
        }
    </ul>
</nav>
