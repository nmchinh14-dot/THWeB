@model IReadOnlyList<HangHoa>

@if (Model.Count == 0)
{
    <p class="empty-state">Không có hàng hóa phù hợp.</p>
}
else
{
    <div class="section group product-grid">
        @foreach (var hang in Model)
        {
            <article class="grid_1_of_4 images_1_of_4" data-ma-hang="@hang.MaHang" data-ma-loai="@hang.MaLoai">
                <div class="product-image">
                    <img src="@Url.Content("~/images/" + hang.Anh)" alt="@hang.TenHang" data-product-image data-fallback-src="@Url.Content("~/images/feature-pic1.jpg")" />
                </div>
                <h2>@hang.TenHang</h2>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@hang.Gia?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</span></p>
                    </div>
                    <div class="add-cart">
                        <button type="button" data-add-to-cart data-price="@hang.Gia?.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Thêm @hang.TenHang vào giỏ">Add to Cart</button>
                    </div>
                    <div class="clear"></div>
                </div>
            </article>
        }
    </div>
}
